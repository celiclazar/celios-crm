{
    "name": "celios/crm",
    "description": "Modular, pluggable CRM engine for Celios CMS supporting local management and third-party CRM drivers.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Lazar Celic",
            "email": "celiclazar@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4 || ^8.5",
        "celios/core": "^1.0",
        "filament/filament": "^5.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Modules\\Crm\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.x-dev",
            "dev-main": "1.x-dev"
        },
        "laravel": {
            "providers": [
                "Modules\\Crm\\CrmServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
